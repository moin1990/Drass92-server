# ─────────────────────────────────────────────────────────
# IdeaVault Server — Environment Variable Template
# Copy to .env for local development
# ─────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ideavault?retryWrites=true&w=majority

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Development client URL
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK (optional in development — falls back gracefully)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=